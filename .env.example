# Copy to .env if you want to override the docker-compose defaults.
# These values are for local development only.

POSTGRES_USER=familyhub
POSTGRES_PASSWORD=familyhub
POSTGRES_DB=familyhub
POSTGRES_PORT=5433

DATABASE_URL=postgresql+psycopg://familyhub:familyhub@db:5432/familyhub
TEST_DATABASE_URL=postgresql+psycopg://familyhub:familyhub@db:5432/familyhub_test

JWT_SECRET=dev-only-change-me-use-a-long-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=Demo123!
DEMO_USER_NAME=Demo User

BACKEND_PORT=8000
FRONTEND_PORT=5173
